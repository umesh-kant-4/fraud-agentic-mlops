{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "MlWorkloadServices", "Effect": "Allow", "Action": ["sagemaker:*", "cloudwatch:PutMetricData", "cloudwatch:GetMetricData", "cloudwatch:DescribeAlarms", "cloudwatch:ListMetrics", "xray:Put*", "xray:GetSampling*", "ecr:GetAuthorizationToken", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability", "bedrock-agentcore:*", "logs:DescribeLogGroups"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "${REGION}"}}},
    {"Sid": "ProjectLogGroups", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams", "logs:GetLogEvents"], "Resource": ["arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/Fraud*", "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/sagemaker/*", "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/*", "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:aws/spans*"]},
    {"Sid": "ModelCalls", "Effect": "Allow", "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"], "Resource": ["arn:aws:bedrock:*::foundation-model/anthropic.*", "arn:aws:bedrock:*:${ACCOUNT_ID}:inference-profile/*"]},
    {"Sid": "ProjectBucketsInThisAccountOnly", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketAcl", "s3:AbortMultipartUpload", "s3:CreateBucket"], "Resource": ["arn:aws:s3:::fraudmlopscore-*", "arn:aws:s3:::fraudmlopscore-*/*", "arn:aws:s3:::sagemaker-${REGION}-${ACCOUNT_ID}", "arn:aws:s3:::sagemaker-${REGION}-${ACCOUNT_ID}/*", "arn:aws:s3:::cdk-fraudmlops-assets-${ACCOUNT_ID}-${REGION}/*"], "Condition": {"StringEquals": {"aws:ResourceAccount": "${ACCOUNT_ID}"}}},
    {"Sid": "ProjectStateAndNotifications", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query", "sns:Publish", "ssm:GetParameter", "ssm:GetParameters", "lambda:InvokeFunction"], "Resource": ["arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/FraudMlopsCore-*", "arn:aws:sns:${REGION}:${ACCOUNT_ID}:FraudMlopsCore-*", "arn:aws:ssm:${REGION}:${ACCOUNT_ID}:parameter/fraud-mlops/*", "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:Fraud*"]},
    {"Sid": "PassOnlyTheSageMakerRoleToSageMaker", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/FraudMlopsCore-SageMakerRole*", "Condition": {"StringEquals": {"iam:PassedToService": "sagemaker.amazonaws.com"}}},
    {"Sid": "ReadTheSageMakerRole", "Effect": "Allow", "Action": "iam:GetRole", "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/FraudMlopsCore-SageMakerRole*"},
    {"Sid": "NoApprovalNoInteractiveNoCredentials", "Effect": "Deny", "Action": ["sagemaker:UpdateModelPackage", "sagemaker:DeleteModelPackage", "sagemaker:DeleteModelPackageGroup", "sagemaker:CreateNotebookInstance", "sagemaker:CreatePresignedNotebookInstanceUrl", "sagemaker:CreatePresignedDomainUrl", "sagemaker:CreateDomain", "sagemaker:CreateUserProfile", "bedrock-agentcore:GetResourceApiKey", "bedrock-agentcore:GetResourceOauth2Token"], "Resource": "*"},
    {"Sid": "NoProductionEndpointChanges", "Effect": "Deny", "Action": ["sagemaker:CreateEndpoint", "sagemaker:UpdateEndpoint", "sagemaker:UpdateEndpointWeightsAndCapacities", "sagemaker:DeleteEndpoint"], "Resource": "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:endpoint/fraud-mlops-*"},
    {"Sid": "NewModelsOnlyAsPendingApproval", "Effect": "Deny", "Action": "sagemaker:CreateModelPackage", "Resource": "*", "Condition": {"StringNotEquals": {"sagemaker:ModelApprovalStatus": "PendingManualApproval"}}}
  ]
}
