{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectConfigRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:${REGION}:${ACCOUNT_ID}:parameter/fraud-mlops/*"
    },
    {
      "Sid": "SetAgentModelId",
      "Effect": "Allow",
      "Action": "ssm:PutParameter",
      "Resource": "arn:aws:ssm:${REGION}:${ACCOUNT_ID}:parameter/fraud-mlops/agent-model-id"
    },
    {
      "Sid": "ReadOnlyVisibility",
      "Effect": "Allow",
      "Action": [
        "cloudformation:Describe*", "cloudformation:List*", "cloudformation:GetTemplate*",
        "sagemaker:Describe*", "sagemaker:List*", "sagemaker:Search",
        "bedrock-agentcore:GetAgentRuntime", "bedrock-agentcore:GetAgentRuntimeEndpoint",
        "bedrock-agentcore:GetGateway", "bedrock-agentcore:GetGatewayTarget",
        "bedrock-agentcore:ListAgentRuntimes", "bedrock-agentcore:ListAgentRuntimeEndpoints",
        "bedrock-agentcore:ListAgentRuntimeVersions", "bedrock-agentcore:ListGateways",
        "bedrock-agentcore:ListGatewayTargets",
        "cloudwatch:GetMetricData", "cloudwatch:ListMetrics", "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups", "logs:GetQueryResults", "logs:StopQuery",
        "xray:GetTraceSummaries", "xray:BatchGetTraces",
        "lambda:GetFunction", "lambda:ListFunctions", "events:DescribeRule", "events:ListRules",
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadProjectLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents",
                 "logs:StartQuery"],
      "Resource": [
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/Fraud*",
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/sagemaker/*",
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/*",
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:aws/spans*"
      ]
    },
    {
      "Sid": "ReadOpsTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:Scan", "dynamodb:DescribeTable"],
      "Resource": "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/FraudMlopsCore-Ops*"
    },
    {
      "Sid": "ProjectDataBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::fraudmlopscore-data*", "arn:aws:s3:::fraudmlopscore-data*/*"]
    },
    {
      "Sid": "SageMakerSdkDefaultBucket",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:ListBucket", "s3:GetObject", "s3:PutObject",
                 "s3:GetBucketLocation", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::sagemaker-${REGION}-${ACCOUNT_ID}",
                   "arn:aws:s3:::sagemaker-${REGION}-${ACCOUNT_ID}/*"]
    },
    {
      "Sid": "RunTrainingPipeline",
      "Effect": "Allow",
      "Action": ["sagemaker:CreatePipeline", "sagemaker:UpdatePipeline",
                 "sagemaker:StartPipelineExecution", "sagemaker:StopPipelineExecution",
                 "sagemaker:RetryPipelineExecution", "sagemaker:AddTags"],
      "Resource": ["arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:pipeline/fraud-mlops-*",
                   "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:pipeline/fraud-mlops-*/execution/*"]
    },
    {
      "Sid": "ModelMonitorSetupAndRemoval",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateProcessingJob", "sagemaker:StopProcessingJob",
                 "sagemaker:CreateMonitoringSchedule", "sagemaker:UpdateMonitoringSchedule",
                 "sagemaker:DeleteMonitoringSchedule", "sagemaker:StartMonitoringSchedule",
                 "sagemaker:StopMonitoringSchedule", "sagemaker:CreateDataQualityJobDefinition",
                 "sagemaker:DeleteDataQualityJobDefinition", "sagemaker:AddTags"],
      "Resource": [
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:processing-job/*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:monitoring-schedule/fraud-mlops-*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:data-quality-job-definition/*"
      ]
    },
    {
      "Sid": "EndpointTrafficAndRemoval",
      "Effect": "Allow",
      "Action": ["sagemaker:InvokeEndpoint", "sagemaker:DeleteEndpoint",
                 "sagemaker:DeleteEndpointConfig", "sagemaker:DeleteModel"],
      "Resource": [
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:endpoint/fraud-mlops-*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:endpoint-config/fraud-epc-*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:model/fraud-model-*"
      ]
    },
    {
      "Sid": "PassOnlyTheProjectSageMakerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/FraudMlopsCore-SageMakerRole*",
      "Condition": {"StringEquals": {"iam:PassedToService": "sagemaker.amazonaws.com"}}
    },
    {
      "Sid": "TalkToTheProjectAgent",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:InvokeAgentRuntime", "bedrock-agentcore:StopRuntimeSession"],
      "Resource": ["arn:aws:bedrock-agentcore:${REGION}:${ACCOUNT_ID}:runtime/*Fraud*",
                   "arn:aws:bedrock-agentcore:${REGION}:${ACCOUNT_ID}:runtime/*Fraud*/*"]
    },
    {
      "Sid": "LocalAgentDevModelCalls",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": ["arn:aws:bedrock:*::foundation-model/anthropic.*",
                   "arn:aws:bedrock:*:${ACCOUNT_ID}:inference-profile/*"]
    }
  ]
}
